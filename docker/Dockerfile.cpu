ARG NODE_IMAGE=node:22-bookworm-slim
ARG PYTHON_BASE_IMAGE=python:3.12-slim-bookworm
FROM ${NODE_IMAGE} AS frontend
WORKDIR /src/frontend
COPY frontend/package.json frontend/package-lock.json* ./
RUN npm install
COPY frontend/ ./
RUN npm run build

FROM ${PYTHON_BASE_IMAGE}
ARG SHERPA_ONNX_VERSION=1.13.8
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    VVOICE_PROVIDER=cpu \
    VVOICE_PORT=7070
WORKDIR /app
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl ffmpeg libgomp1 libsndfile1 \
    && rm -rf /var/lib/apt/lists/*
COPY pyproject.toml README.md ./
COPY vvoice ./vvoice
COPY catalog ./catalog
ARG PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
RUN python -m pip install --no-cache-dir --index-url "${PIP_INDEX_URL}" . \
    && python -m pip install --no-cache-dir --index-url "${PIP_INDEX_URL}" "onnxruntime>=1.18,<2" \
    && python -m pip install --no-cache-dir --index-url "${PIP_INDEX_URL}" sherpa-onnx==${SHERPA_ONNX_VERSION}
COPY --from=frontend /src/frontend/dist ./frontend/dist
RUN python -c "import onnxruntime, sherpa_onnx; assert 'CPUExecutionProvider' in onnxruntime.get_available_providers(); print(sherpa_onnx.__version__)"
EXPOSE 7070
CMD ["python", "-m", "uvicorn", "vvoice.main:app", "--host", "0.0.0.0", "--port", "7070"]
