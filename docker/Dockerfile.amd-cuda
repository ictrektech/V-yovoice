ARG NODE_IMAGE=node:22-bookworm-slim
ARG CUDA_RUNTIME_BASE_IMAGE=swr.cn-southwest-2.myhuaweicloud.com/ictrek/nvidia-cuda:amd_12.8.1-runtime-ubuntu22.04
ARG CUDA_CUDNN_BASE_IMAGE=swr.cn-southwest-2.myhuaweicloud.com/ictrek/nvidia-cuda:amd_12.8.1-cudnn-devel-ubuntu22.04
FROM ${NODE_IMAGE} AS frontend
WORKDIR /src/frontend
COPY frontend/package.json frontend/package-lock.json* ./
RUN npm install
COPY frontend/ ./
COPY web/src/shared/ /src/web/src/shared/
RUN npm run build

FROM ${CUDA_CUDNN_BASE_IMAGE} AS cudnn
# 先在同一目录保留链接关系，避免跨阶段通配符 COPY 将链接展开为三份文件。
RUN mkdir /cudnn-runtime \
    && cp -a /usr/lib/x86_64-linux-gnu/libcudnn*.so* /cudnn-runtime/

FROM ${CUDA_RUNTIME_BASE_IMAGE}
ARG SHERPA_ONNX_VERSION=1.13.8
ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    VVOICE_PROVIDER=cuda \
    VVOICE_PORT=7070
WORKDIR /app
COPY --from=cudnn /cudnn-runtime/ /usr/lib/x86_64-linux-gnu/
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl ffmpeg libgomp1 libsndfile1 python3 python3-pip \
    && rm -rf /var/lib/apt/lists/*
COPY pyproject.toml README.md ./
COPY vvoice ./vvoice
COPY catalog ./catalog
ARG PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
# 安装包只读挂载到安装步骤，不进入任何成品镜像层。
RUN --mount=type=bind,from=sherpa_wheels,source=/,target=/tmp/sherpa-wheels \
    python3 -m pip install --no-cache-dir --index-url "${PIP_INDEX_URL}" --upgrade pip setuptools wheel \
    && python3 -m pip install --no-cache-dir --index-url "${PIP_INDEX_URL}" . "onnxruntime-gpu>=1.22,<2" \
    && python3 -m pip install --no-cache-dir --verbose --timeout 120 \
      "sherpa-onnx==${SHERPA_ONNX_VERSION}+cuda12.cudnn9.onnxruntime1.28.2" \
      --no-index -f /tmp/sherpa-wheels
COPY --from=frontend /src/frontend/dist ./frontend/dist
RUN python3 -c "import sherpa_onnx; assert '+cuda' in sherpa_onnx.__version__; print(sherpa_onnx.__version__)"
EXPOSE 7070
CMD ["python3", "-m", "uvicorn", "vvoice.main:app", "--host", "0.0.0.0", "--port", "7070"]
